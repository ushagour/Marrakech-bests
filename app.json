{
  "expo": {
    "name": "Marrakech Bites",
    "owner": "ushagour",
    "slug": "Marrakech-bests",
    "description": "A fast-food app for discovering and ordering Moroccan-inspired street food.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#245642"
      },
      "package": "com.ushagour.marrakechbites"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/MarkaziText-Regular.ttf",
            "./assets/fonts/Karla-Regular.ttf",
            "./assets/fonts/MarkaziText-Medium.ttf",
            "./assets/fonts/Karla-Bold.ttf"
          ]
        }
      ],
      "expo-sqlite",
      "expo-image",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/Logo-splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d4310f1e-9998-4d09-a00e-832e63b31c26"
      }
    }
  }
}
